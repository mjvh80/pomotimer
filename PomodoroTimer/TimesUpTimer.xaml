<?xml version="1.0" encoding="utf-8" ?>
<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" 
        Topmost="True" WindowStyle="None"
        xmlns:pomoctrls="clr-namespace:Controls;assembly=PomodoroTimer"

        Background="Transparent" AllowsTransparency="true" Name="Root" Height="175.336" Width="200">

    <TextBlock x:Name="TimesUpTimerText" LineStackingStrategy="BlockLineHeight" LineHeight="200" FontSize="200" Height="180" Background="#00000000" Foreground="DarkRed" HorizontalAlignment="Center" VerticalAlignment="Center" 
               Padding="20,0,20,0" Margin="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" Text="7" FontWeight="SemiBold">
        <TextBlock.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="White" Direction="330" />
        </TextBlock.Effect>
        <TextBlock.Resources>
            <Storyboard x:Key="Animation">
                <!--<Int32Animation
                        Storyboard.TargetName="TimesUpTimerText" Storyboard.TargetProperty="Text"
                        From="10" To="0" Duration="0:0:10" />-->
                <StringAnimationUsingKeyFrames Storyboard.TargetName="TimesUpTimerText" Storyboard.TargetProperty="Text" BeginTime="0:0:0">
                    <!--This is crap, but KISS-->
                    <DiscreteStringKeyFrame Value="9" KeyTime="0:0:0" />
                    <DiscreteStringKeyFrame Value="8" KeyTime="0:0:1" />
                    <DiscreteStringKeyFrame Value="7" KeyTime="0:0:2" />
                    <DiscreteStringKeyFrame Value="6" KeyTime="0:0:3" />
                    <DiscreteStringKeyFrame Value="5" KeyTime="0:0:4" />
                    <DiscreteStringKeyFrame Value="4" KeyTime="0:0:5" />
                    <DiscreteStringKeyFrame Value="3" KeyTime="0:0:6" />
                    <DiscreteStringKeyFrame Value="2" KeyTime="0:0:7" />
                    <DiscreteStringKeyFrame Value="1" KeyTime="0:0:8" />
                </StringAnimationUsingKeyFrames>
                <StringAnimationUsingKeyFrames Storyboard.TargetName="TimesUpTimerText" Storyboard.TargetProperty="Text" AutoReverse="True" RepeatBehavior="Forever" Duration="0:0:1" BeginTime="0:0:9">
                    <DiscreteStringKeyFrame Value=" " KeyTime="0:0:0" />
                    <DiscreteStringKeyFrame Value="!" KeyTime="0:0:0.5" />
                </StringAnimationUsingKeyFrames>


            </Storyboard>
        </TextBlock.Resources>
    </TextBlock>

</Window>